{
  "name": "multilingual-stemmer",
  "version": "2.0.0",
  "description": "Word stemming for 34 languages (English, Arabic, Russian, French, German, Spanish, Turkish and more) via Snowball algorithms compiled to WebAssembly. TypeScript-first · Node.js · Browser · Zero dependencies.",
  "author": "Vladislav Tupikin <vladislav.tupikin@icloud.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "browser": {
        "import": "./dist/index.browser.js",
        "types": "./dist/index.d.ts"
      },
      "default": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile:wasm": "pnpm exec wasm-pack build ./rust-stemmers --out-dir ../dist/browser --release --target web --out-name index",
    "compile:ts": "tsc",
    "compile": "pnpm run compile:wasm && tsx prepare.ts && pnpm run compile:ts",
    "prepublishOnly": "pnpm run compile && pnpm run optimize",
    "optimize": "pnpm exec wasm-opt ./dist/browser/index_bg.wasm -o ./dist/browser/index_bg.wasm",
    "test": "vitest run",
    "demo": "npx serve . -l 4000"
  },
  "keywords": [
    "stemmer",
    "stemming",
    "word-stemming",
    "nlp",
    "natural-language-processing",
    "text-analysis",
    "text-processing",
    "search-indexing",
    "snowball",
    "linguistic",
    "morphology",
    "webassembly",
    "wasm",
    "typescript",
    "browser",
    "esm",
    "multilingual",
    "arabic",
    "english",
    "russian",
    "french",
    "german",
    "spanish",
    "portuguese",
    "turkish"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRefactoring/multilingual-stemmer.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wasm-opt": "^1.4.0",
    "wasm-pack": "^0.15.0"
  }
}
